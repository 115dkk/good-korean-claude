{
  "description": "Three separate checks on Korean text: a translationese judge for every Korean line an edit adds, an em-dash ban for Korean Markdown files, and a check that the final reply and every question Claude asks have no em-dash and are not mostly English.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/korean_judge.py",
              "--rules",
              "${CLAUDE_PLUGIN_ROOT}/skills/chegyejeog-chulonja-v4-style/SKILL.md",
              "--section",
              "# 2. 한국어",
              "--scope",
              "korean",
              "--label",
              "번역투 판정"
            ],
            "timeout": 180,
            "statusMessage": "translationese check (Claude Sonnet 5.5)"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/block_emdash.py"
            ],
            "timeout": 15,
            "statusMessage": "em-dash check"
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/report_guard.py"
            ],
            "timeout": 15,
            "statusMessage": "question check (em-dash, English ratio)"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/report_guard.py"
            ],
            "timeout": 15,
            "statusMessage": "reply check (em-dash, English ratio)"
          }
        ]
      }
    ]
  }
}
